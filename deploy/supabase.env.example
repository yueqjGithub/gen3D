# 复制到仓库根目录的 .env.supabase，再在本机填写。该实际配置文件已被 .gitignore 忽略。
# 不要把数据库密码、连接串、Secret key 发到聊天或提交到 GitHub。

# Supabase 项目顶部 Connect 中的 Project URL（也可以在 Data API 页面找到）。
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Settings → API Keys → Secret keys，复制 sb_secret_ 开头的值。
# 仅服务端使用，不能写入 Vite 配置。新项目优先用新 Secret key，避免依赖即将弃用的 legacy key。
SUPABASE_SECRET_KEY=REPLACE_WITH_SECRET_KEY

# 项目顶部 Connect → Transaction pooler，复制实际连接串并填入数据库密码。
# 本机保存控制台提供的池化连接即可；Node Server、Agent 和初始化脚本统一连接 5432 Session pooler。
# 密码中的 @、#、/ 等字符需要做 URL 编码，保留控制台提供的真实主机名和用户名。
DATABASE_URL=REPLACE_WITH_TRANSACTION_POOLER_CONNECTION_STRING

# 私有 Storage bucket 名称；验证程序将只读写自己的临时文件。
SUPABASE_STORAGE_BUCKET=agent3d

# Server 和 Agent 都使用它验证数据库 TLS。容器内由 compose 覆盖为 /app/deploy/supabase-ca.crt。
SUPABASE_CA_PATH=D:/YOUR_PROJECT/deploy/supabase-ca.crt
