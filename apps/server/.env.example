# Copy values into the environment before starting the local server.
# All processes should use the root .env.example to share these loopback settings.
AGENT3D_MOCK_MODE=false
AGENT3D_SERVER_URL=http://127.0.0.1:62586
AGENT3D_SERVER_TOKEN=local-hono-token-change-me
AGENT3D_RENDERER_ORIGIN=http://localhost:5173
AGENT3D_DATA_DIR=
AGENT3D_AGENT_URL=http://127.0.0.1:62687
AGENT3D_AGENT_TOKEN=local-agent3d-token-change-me
AGENT3D_CREDENTIAL_BROKER_PORT=62588
AGENT3D_CREDENTIAL_BROKER_TOKEN=local-credential-broker-token-change-me
AGENT3D_CHAT_API_KEY=
AGENT3D_IMAGE_API_KEY=
