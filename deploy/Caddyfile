{$SITE_ADDRESS} {
	# 直接展示应用登录页；Server 使用签名 Cookie 和密码校验保护业务接口。

	@api path /api /api/*
	handle @api {
		request_body {
			max_size 21MB
		}
		reverse_proxy server:62586 {
			# 逐块转发 SSE，用户等待问题或审批时也保持长响应。
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
