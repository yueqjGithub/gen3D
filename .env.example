# Copy this file to .env for local development. Replace each token before sharing a machine.
AGENT3D_MOCK_MODE=true

# Renderer -> Hono API. Electron's dev renderer is fixed to http://localhost:5173.
AGENT3D_SERVER_URL=http://127.0.0.1:62586
AGENT3D_SERVER_TOKEN=local-hono-token-change-me
AGENT3D_RENDERER_ORIGIN=http://localhost:5173

# Optional shared root for data/agent3d.sqlite, attachments/, and credentials.json.
# Relative paths resolve from the current user's home directory.
AGENT3D_DATA_DIR=

# Hono -> Mastra Agent.
AGENT3D_AGENT_URL=http://127.0.0.1:62687
AGENT3D_AGENT_PORT=62687
AGENT3D_AGENT_TOKEN=local-agent3d-token-change-me

# Electron main hosts the safeStorage credential broker on this loopback port.
# Broker URL: http://127.0.0.1:62588
AGENT3D_CREDENTIAL_BROKER_PORT=62588
AGENT3D_CREDENTIAL_BROKER_TOKEN=local-credential-broker-token-change-me

# Optional Agnes chat key. The in-app credential form is encrypted with OS safeStorage.
AGENT3D_CHAT_API_KEY=
# Reserved for a future image-generation request path.
AGENT3D_IMAGE_API_KEY=
