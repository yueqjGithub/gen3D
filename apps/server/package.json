{
  "name": "@agent3d/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file=../../.env.supabase --env-file=../../.env.server --import tsx --watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:@mastra/pg --external:@mastra/libsql --external:@hono/node-server --external:ai --external:better-sqlite3 --external:hono --external:pdfjs-dist --external:zod --outfile=dist/index.js",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.supabase --env-file-if-exists=../../.env.server dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:init": "node scripts/initialize-postgres.mjs"
  },
  "dependencies": {
    "@agent3d/shared": "workspace:*",
    "@hono/node-server": "1.19.0",
    "@mastra/libsql": "1.30.0",
    "ai": "7.0.159",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.14",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7",
    "@mastra/pg": "1.36.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "5.0.5"
  }
}
